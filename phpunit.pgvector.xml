<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tests that need real PostgreSQL with pgvector (vector similarity search).
    The default suite uses in-memory SQLite, where vector search always returns nothing.

    The database name is forced to `testing`: RefreshDatabase wipes whatever database it connects to,
    so this config must never pick up DB_DATABASE from .env.

    Local: docker exec laravel_app vendor/bin/pest -c phpunit.pgvector.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnSkipped="true"
>
    <testsuites>
        <testsuite name="Pgvector">
            <directory>tests/Feature/Pgvector</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
